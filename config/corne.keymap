#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE   0
#define SYM    1
#define NAV    2
#define ADJUST 3

/* Space/NAV and Enter/SYM thumbs: taps still fire on release, but pressing and
 * releasing another key while the thumb is held selects the layer immediately
 * instead of waiting for the tapping term.
 */
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
};

/ { 

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };  

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <SYM NAV>;
            then-layer = <ADJUST>;
        };
    };

    keymap  {

        compatible = "zmk,keymap";

/* Layer 0: Base (Colemak-DH)
 * ,-----.-----.-----.-----.-----.                      ,-----.-----.-----.-----.-----.
 * |  Q  |  W  |  F  |  P  |  G  |                      |  J  |  L  |  U  |  Y  |  ;  |
 * |-----+-----+-----+-----+-----|                      |-----+-----+-----+-----+-----|
 * |  A  |R/Ctl|S/Alt|T/Gui|  D  |                      |  H  |N/Gui|E/Alt|I/Ctl|  O  |
 * |-----+-----+-----+-----+-----+                      |-----+-----+-----+-----+-----|
 * |  Z  |  X  |  C  |  V  |  B  |                      |  K  |  M  |  ,  |  .  |  /  |
 * `-----'-----'-----'-----'-----'                      `-----'-----'-----'-----'-----'
 *               .-------.-------.-------.      .-------.-------.-------.
 *               |  TAB  |  ESC  |SPC/NAV|      |ENT/SYM| BSPC  | SHIFT |
 *               '-------'-------'-------'      '-------'-------'-------'
 */
        default_layer {
            bindings = <
        &none &kp Q     &kp W       &kp F       &kp P       &kp G           &kp J &kp L         &kp U       &kp Y       &kp SEMI &none
        &none &kp A     &hm LCTRL R &hm LALT S  &hm LGUI T  &kp D           &kp H &hm RGUI N    &hm LALT E  &hm LCTRL I &kp O &none    
        &none &kp Z     &kp X       &kp C       &kp V       &kp B           &kp K &kp M         &kp COMMA   &kp DOT     &kp FSLH &none
                              &kp TAB &kp ESC &lt NAV SPACE                 &lt SYM ENTER &kp BSPC &kp LSHIFT
            >;
       };
/* Layer 1: Symbols (hold Enter). Unshifted symbol above its shifted pair;
 * top row matches Shift+1..0. Left home-row mods stay transparent.
 * ,-----.-----.-----.-----.-----.                      ,-----.-----.-----.-----.-----.
 * |  !  |  @  |  #  |  $  |  %  |                      |  ^  |  &  |  *  |  (  |  )  |
 * |-----+-----+-----+-----+-----|                      |-----+-----+-----+-----+-----|
 * |  `  | Ctl | Alt | Gui |  '  |                      |  -  |  =  |  [  |  ]  |  \  |
 * |-----+-----+-----+-----+-----+                      |-----+-----+-----+-----+-----|
 * |  ~  |     |     |     |  "  |                      |  _  |  +  |  {  |  }  |  |  |
 * `-----'-----'-----'-----'-----'                      `-----'-----'-----'-----'-----'
 *               .-------.-------.-------.      .-------.-------.-------.   
 *               |       |       |       |      |       |       |       |
 *               '-------'-------'-------'      '-------'-------'-------' 
 */
      	sym_layer {
            bindings = <
		&none &kp EXCL  &kp AT     &kp HASH  &kp DOLLAR     &kp PRCNT       &kp CARET      &kp AMPS  &kp STAR &kp LPAR &kp RPAR &none
        &none &kp GRAVE &trans     &trans    &trans         &kp SQT         &kp MINUS      &kp EQUAL &kp LBKT &kp RBKT &kp BSLH &none    
    	&none &kp TILDE &none      &none     &none          &kp DQT         &kp UNDERSCORE &kp PLUS  &kp LBRC &kp RBRC &kp PIPE &none 
					   &trans &trans &trans                                             &trans &trans &trans
		    >;
		};

/* Layer 2: Numbers / Navigation (hold Space). Left home-row mods stay
 * transparent; right Shift thumb stays free for Mod+Shift+number/arrow.
 * ,-----.-----.-----.-----.-----.                      ,-----.-----.-----.-----.-----.
 * |  1  |  2  |  3  |  4  |  5  |                      |  6  |  7  |  8  |  9  |  0  |
 * |-----+-----+-----+-----+-----|                      |-----+-----+-----+-----+-----|
 * |     | Ctl | Alt | Gui |     |                      |LEFT |DOWN | UP  |RGHT | DEL |
 * |-----+-----+-----+-----+-----+                      |-----+-----+-----+-----+-----|
 * |     |     |     |     |     |                      |HOME |PGDN |PGUP | END |     |
 * `-----'-----'-----'-----'-----'                      `-----'-----'-----'-----'-----'
 *               .-------.-------.-------.      .-------.-------.-------.   
 *               |       |       |       |      |       |       |       |
 *               '-------'-------'-------'      '-------'-------'-------' 
 */
		nav_layer {
		    bindings = <
		&none &kp N1 &kp N2 &kp N3 &kp N4 &kp N5         &kp N6   &kp N7    &kp N8    &kp N9    &kp N0  &none
		&none &trans &trans &trans &trans &trans         &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &kp DEL &none
		&none &trans &trans &trans &trans &trans         &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans  &none
					   &trans &trans &trans                                             &trans &trans &trans
		    >;
		};

/* Layer 3: Adjust (SYM + NAV). BOOT/RESET act on the half they are pressed on.
 * ,-----.-----.-----.-----.-----.                      ,-----.-----.-----.-----.-----.
 * |BRI+ |PREV |PLAY |NEXT |VOL+ |                      | F1  | F2  | F3  | F4  | F5  |
 * |-----+-----+-----+-----+-----|                      |-----+-----+-----+-----+-----|
 * |BRI- |BOOT |RESET|USB/ |VOL- |                      | F6  | F7  | F8  | F9  | F10 |
 * |     |     |     | BLE |     |                      |     |     |     |     |     |
 * |-----+-----+-----+-----+-----+                      |-----+-----+-----+-----+-----|
 * |BTCLR| BT0 | BT1 | BT2 |MUTE |                      | F11 | F12 |CAPSW|RESET|BOOT |
 * `-----'-----'-----'-----'-----'                      `-----'-----'-----'-----'-----'
 *               .-------.-------.-------.      .-------.-------.-------.   
 *               |       |       |       |      |       |       |       |
 *               '-------'-------'-------'      '-------'-------'-------' 
 */
		adjust_layer {
		    bindings = <
		&none &kp C_BRI_INC &kp C_PREV   &kp C_PP     &kp C_NEXT   &kp C_VOL_UP   		&kp F1  &kp F2  &kp F3     &kp F4     &kp F5      &none
		&none &kp C_BRI_DEC &bootloader  &sys_reset   &out OUT_TOG &kp C_VOL_DN			&kp F6  &kp F7  &kp F8     &kp F9     &kp F10     &none
		&none &bt BT_CLR    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &kp C_MUTE	        &kp F11 &kp F12 &caps_word &sys_reset &bootloader &none
					   &trans &trans &trans                                             &trans &trans &trans
		    >;
		};        
    };
};
